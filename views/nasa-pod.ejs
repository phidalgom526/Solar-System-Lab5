<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { pageTitle: "NASA Picture of the Day" }) %>
<body>
    <%- include('partials/navbar', { planets }) %>

    <main class="container py-4">
        <h1>NASA Picture of the Day</h1>
        <% if (podError) { %>
            <p class="alert alert-warning">Could not request NASA's Picture of the Day. Please try again.</p>
        <% } else if (picture) { %>
            <div class="row g-4 align-items-start">
                <div class="col-12 col-md-6">
                    <% if (picture.media_type === 'video') { %>
                        <p>This day's NASA feature is a video.</p>
                        <a href="<%= picture.url %>" target="_blank" rel="noopener">Watch today's NASA video</a>
                    <% } else { %>
                        <img src="<%= picture.url %>" alt="NASA Picture of the Day" class="planet-image">
                    <% } %>
                </div>
                <div class="col-12 col-md-6">
                    <h2><%= picture.title %></h2>
                    <p><strong>Date:</strong> <%= picture.date %></p>
                    <p><%= picture.explanation %></p>
                    <% if (picture.copyright) { %>
                        <p><strong>Copyright:</strong> <%= picture.copyright %></p>
                    <% } %>
                </div>
            </div>
        <% } %>
    </main>

    <%- include('partials/footer') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
