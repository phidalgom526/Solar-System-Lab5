<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { pageTitle: title }) %>
<body>
    <%- include('partials/navbar', { planets }) %>

    <main class="container py-4">
        <h1><%= title %></h1>
        <div class="row g-4 align-items-start">
            <% if (information.image) { %>
                <div class="col-12 col-md-6">
                    <img src="<%= information.image %>" alt="<%= title %>" class="planet-image">
                </div>
            <% } %>
            <div class="col-12 col-md-6">
                <% Object.keys(information).forEach(function(property) { %>
                    <% if (property !== 'image' && property !== 'link') { %>
                        <p><strong><%= property.replace(/([A-Z])/g, ' $1') %>:</strong> <%= information[property] %></p>
                    <% } %>
                <% }); %>
                <% if (information.link) { %>
                    <p><a href="<%= information.link %>" target="_blank" rel="noopener">Learn more from NASA</a></p>
                <% } %>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
